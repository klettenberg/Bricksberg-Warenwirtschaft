{
    "name": "bricksberg/bricksberg-warenwirtschaft",
    "description": "Professional inventory management system for LEGO retailers",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Bricksberg",
            "email": "info@bricksberg.eu",
            "homepage": "https://bricksberg.eu"
        }
    ],
    "require": {
        "php": ">=8.0",
        "composer/installers": "~2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=WordPress .",
        "lint-fix": "phpcbf --standard=WordPress ."
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "keywords": [
        "wordpress",
        "woocommerce",
        "inventory",
        "lego",
        "bricklink",
        "brickowl",
        "rebrickable"
    ],
    "support": {
        "issues": "https://github.com/bricksberg/bricksberg-warenwirtschaft/issues",
        "source": "https://github.com/bricksberg/bricksberg-warenwirtschaft"
    }
}
